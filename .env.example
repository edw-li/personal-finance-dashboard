# ── Database (host PostgreSQL) ────────────────────────────
POSTGRES_USER=finance
POSTGRES_PASSWORD=<your-db-password>
POSTGRES_DB=finance

# ── Backend ───────────────────────────────────────────────
ENVIRONMENT=prod
# Generate with: openssl rand -hex 32 (prod requires >= 32 bytes)
SECRET_KEY=<your-secret-key>
# The origin you access the app at — https://<instance-public-ip>, or your
# domain if you set one up (comma-separate to allow both during a switch)
CORS_ORIGINS=https://<instance-public-ip>
# The same origin again, without a trailing slash: the calendar .ics/feed writes it in
# front of the page links inside each event, so a phone can tap through from its calendar
# app. Unset = the events carry bare paths, which a phone cannot open.
PUBLIC_URL=https://<instance-public-ip>
ADMIN_EMAIL=<your-login-email>
# 8-72 BYTES (bcrypt limit; accented characters count as 2+ bytes)
ADMIN_PASSWORD=<your-login-password>

# ── OCI Object Storage (nightly DB backups; see README) ──
# Customer secret key generated under OCI Console → My profile
OCI_ACCESS_KEY=<customer-secret-key-access-key>
OCI_SECRET_KEY=<customer-secret-key-secret>
OCI_BUCKET_NAME=finance-db-backups
# Namespace is shown on the bucket details page
OCI_NAMESPACE=<tenancy-object-storage-namespace>
# Region identifier, e.g. us-sanjose-1
OCI_REGION=<region-identifier>

# Optional: symmetric-encrypt every backup with gpg AES256 before upload (objects land
# as .sql.gz.gpg). Generate: openssl rand -base64 32. Keep a copy of the passphrase OFF
# this server — without it an encrypted backup is unrecoverable. Leave unset for
# plaintext dumps (the script prints a warning per run).
# BACKUP_PASSPHRASE=

# Assistant (optional): build.nvidia.com API key. The dashboard runs fully without it;
# only the ✦ assistant needs it. A key saved in Settings overrides this one.
NVIDIA_API_KEY=
